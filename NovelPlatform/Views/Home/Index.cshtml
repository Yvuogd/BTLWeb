@model List<NovelPlatform.Models.Novel>
@{
    ViewData["Title"] = "Đọc truyện online";

    var categories = ViewBag.Categories as List<NovelPlatform.Models.Category> ?? [];
}

<div class="tc-welcome-banner">
    Truyện Chữ <span>— Kho truyện online dành cho bạn</span>

</div>

        <form asp-controller="Home"
              asp-action="Index"
              method="get"
              class="tc-filter catalog-filter" data-catalog-filter>
            <label for="catalog-query">Tìm truyện</label>
            <input id="catalog-query" name="q" type="search" value="@ViewBag.Query" maxlength="180" />
            <label for="hot-category">Thể loại</label>
            <select id="hot-category" name="category">
                <option value="">Tất cả</option>
                @foreach (var category in categories)
                {
                    if (ViewBag.Category == category.Id)
                    {
                        <option value="@category.Id" selected>@category.Name</option>
                    }
                    else
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                }
            </select>
            <button class="btn btn-outline" type="submit">Lọc</button>
        </form>
<div class="tc-content-grid">
    <div id="novel-catalog" aria-live="polite">
        <partial name="_Catalog" model="Model" />
    </div>
    <aside class="tc-sidebar">
        <section class="tc-panel" id="genre-list">
            <div class="tc-section-head">
                <div>
                    <span class="tc-kicker">CHỌN GU ĐỌC</span>
                    <h2>Thể loại truyện</h2>
                </div>
            </div>
            <div class="tc-genre-list">
                @foreach (var category in categories)
                {
                    <a asp-action="Index" asp-route-category="@category.Id">
                        <span>@category.Name</span>
                        <span>›</span>
                    </a>
                }
            </div>
        </section>

    </aside>
</div>

