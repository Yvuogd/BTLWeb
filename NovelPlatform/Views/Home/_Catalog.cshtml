@model List<NovelPlatform.Models.Novel>
@{
    var featuredNovels = Model;
    var completedNovels = Model.Where(novel => novel.Status == "Completed").ToList();
    var recommendedNovels = Model.OrderByDescending(novel => novel.Ratings.Count == 0
        ? 0 : novel.Ratings.Average(rating => rating.Score)).Take(5).ToList();
}
@if (ViewBag.Genre is string genre && !string.IsNullOrWhiteSpace(genre))
{
    <p>Đang lọc: @genre <a asp-action="Index">Xóa lọc</a></p>
}
<section class="tc-panel tc-hot" id="hot">
    <div class="tc-section-head">
        <div>
            <span class="tc-kicker">ĐƯỢC ĐỌC NHIỀU</span>
            <h1>Truyện hot</h1>
        </div>

    </div>

    <div class="tc-featured-row">
        @foreach (var novel in featuredNovels)
        {
            <a class="tc-featured-card" asp-action="Details" asp-route-id="@novel.Id">
                <div class="tc-featured-cover">
                    <img src="@(novel.CoverImage ?? "/images/cloud-library.svg")"
                         alt="Bìa @novel.Title" />
                    <span>@(novel.Status == "Completed" ? "FULL" : "HOT")</span>
                </div>
                <h2>@novel.Title</h2>
                <small>@novel.Category.Name · @novel.Chapters.Count chương</small>
            </a>
        }

        @if (featuredNovels.Count == 0)
        {
            <p class="tc-empty">Chưa có truyện trong thể loại này.</p>
        }
    </div>
</section>


    <section class="tc-panel tc-latest" id="latest">
        <div class="tc-section-head">
            <div>
                <span class="tc-kicker">VỪA ĐƯỢC CẬP NHẬT</span>
                <h2>Truyện mới cập nhật</h2>
            </div>
            <span class="tc-count">@ViewBag.Total truyện</span>
        </div>

        <div class="tc-update-list">
            @foreach (var novel in Model)
            {
                var latestChapter = novel.Chapters
                    .OrderByDescending(chapter => chapter.Number)
                    .FirstOrDefault();

                <article class="tc-update-row">
                    <a class="tc-update-title"
                       asp-action="Details"
                       asp-route-id="@novel.Id">
                        @novel.Title
                    </a>
                    @if (latestChapter is not null)
                    {
                        <a class="tc-update-chapter"
                           asp-action="Read"
                           asp-route-id="@latestChapter.Id">
                            Chương @latestChapter.Number: @latestChapter.Title
                        </a>
                    }
                    else
                    {
                        <span class="tc-update-chapter">Chưa có chương</span>
                    }
                    <div class="tc-update-meta">
                        <a asp-action="Index" asp-route-category="@novel.CategoryId">
                            @novel.Category.Name
                        </a>
                        <span>
                            @(novel.Status == "Completed" ? "Đã hoàn thành" : "Đang ra")
                        </span>
                    </div>
                </article>
            }

            @if (Model.Count == 0)
            {
                <div class="tc-empty">
                    Không tìm thấy truyện phù hợp. Hãy thử từ khóa hoặc thể loại khác.
                </div>
            }
        </div>
        @if ((int)ViewBag.Pages > 1)
        {
            <nav class="catalog-pages" aria-label="Phân trang truyện">
                @if ((int)ViewBag.Page > 1)
                {
                    <a class="btn btn-outline" data-catalog-page asp-action="Index"
                       asp-route-page="@((int)ViewBag.Page - 1)" asp-route-q="@ViewBag.Query"
                       asp-route-category="@ViewBag.Category" asp-route-genre="@ViewBag.Genre">Trang trước</a>
                }
                <span>Trang @ViewBag.Page / @ViewBag.Pages</span>
                @if ((int)ViewBag.Page < (int)ViewBag.Pages)
                {
                    <a class="btn btn-outline" data-catalog-page asp-action="Index"
                       asp-route-page="@((int)ViewBag.Page + 1)" asp-route-q="@ViewBag.Query"
                       asp-route-category="@ViewBag.Category" asp-route-genre="@ViewBag.Genre">Trang sau</a>
                }
            </nav>
        }
    </section>

<section class="tc-panel tc-completed" id="completed">
    <div class="tc-section-head">
        <div>
            <span class="tc-kicker">ĐỌC TRỌN BỘ</span>
            <h2>Truyện đã hoàn thành trên trang này</h2>
        </div>
        <span class="tc-count">@completedNovels.Count truyện</span>
    </div>

    <div class="tc-completed-grid">
        @foreach (var novel in completedNovels)
        {
            <a class="tc-completed-card" asp-action="Details" asp-route-id="@novel.Id">
                <div class="tc-completed-cover">
                    <img src="@(novel.CoverImage ?? "/images/cloud-library.svg")"
                         alt="Bìa @novel.Title" />
                    <span>FULL</span>
                </div>
                <strong>@novel.Title</strong>
                <small>@novel.Author.DisplayName · @novel.Chapters.Count chương</small>
            </a>
        }

        @if (completedNovels.Count == 0)
        {
            <div class="tc-empty">Truyện hoàn thành sẽ xuất hiện ở đây.</div>
        }
    </div>
</section>
        <section class="tc-panel tc-recommended">
            <div class="tc-section-head">
                <div>
                    <span class="tc-kicker">GỢI Ý CHO BẠN</span>
                    <h2>Truyện đề cử</h2>
                </div>
            </div>
            <ol>
                @for (var index = 0; index < recommendedNovels.Count; index++)
                {
                    var novel = recommendedNovels[index];
                    var rating = novel.Ratings.Count == 0
                        ? "Mới"
                        : novel.Ratings.Average(item => item.Score).ToString("0.0");

                    <li>
                        <span class="tc-rank">@(index + 1)</span>
                        <a asp-action="Details" asp-route-id="@novel.Id">
                            @novel.Title
                            <small>@novel.Category.Name · ★ @rating</small>
                        </a>
                    </li>
                }
            </ol>
        </section>

