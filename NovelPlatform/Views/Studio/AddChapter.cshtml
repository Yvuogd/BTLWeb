@model NovelPlatform.Models.ChapterInput
@{
    int chapterId = ViewBag.ChapterId;
    bool editing = chapterId != 0;
    var novel = (NovelPlatform.Models.Novel)ViewBag.Novel;
    ViewData["Title"] = editing ? "Sửa chương" : "Thêm chương";
}

<div class="form-page">
    <form class="form-card narrow" asp-action="@(editing ? "EditChapter" : "AddChapter")"
          asp-route-id="@(editing ? chapterId : novel.Id)" method="post">
        <a class="back-link" asp-action="Index">← Studio</a>
        <span class="eyebrow">@novel.Title</span>
        <h1>@ViewData["Title"]</h1>
        <div asp-validation-summary="All" class="form-error"></div>

        <label asp-for="Number">Số chương</label>
        <input asp-for="Number" type="number" min="1" required />

        <label asp-for="Title">Tên chương</label>
        <input asp-for="Title" maxlength="180" required />

        <label asp-for="Content">Nội dung</label>
        <textarea asp-for="Content" rows="18" maxlength="100000" required></textarea>

        @if (!User.IsInRole("Admin"))
        {
            <p class="form-hint">Chương sẽ hiển thị sau khi được duyệt.</p>
        }
        <button class="btn btn-dark btn-block" type="submit">Lưu chương</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
