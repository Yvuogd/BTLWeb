@model NovelPlatform.Models.NovelInput
@{
    int novelId = ViewBag.NovelId;
    bool editing = novelId != 0;
    ViewData["Title"] = editing ? "Sửa truyện" : "Tạo truyện";
}

<div class="form-page">
    <form class="form-card narrow" asp-action="@(editing ? "Edit" : "Create")"
          asp-route-id="@(editing ? novelId : (int?)null)" method="post" enctype="multipart/form-data">
        <a class="back-link" asp-action="Index">← Studio</a>
        <h1>@ViewData["Title"]</h1>
        <div asp-validation-summary="All" class="form-error"></div>

        <label asp-for="Title">Tên truyện</label>
        <input asp-for="Title" maxlength="180" required />

        <label asp-for="CategoryId">Thể loại</label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" required>
            <option value="">Chọn thể loại</option>
        </select>

        <label asp-for="Description">Giới thiệu</label>
        <textarea asp-for="Description" rows="5" maxlength="2500"></textarea>

        @if (ViewBag.Cover is string cover)
        {
            <img class="studio-cover-preview" src="@cover" alt="Ảnh bìa hiện tại" />
        }
        <label asp-for="Cover">Ảnh bìa (JPG, PNG hoặc WebP, tối đa 3 MB)</label>
        <input asp-for="Cover" type="file" accept="image/jpeg,image/png,image/webp" />

        <label asp-for="Status">Trạng thái truyện</label>
        <select asp-for="Status">
            <option value="Ongoing">Đang ra</option>
            <option value="Completed">Hoàn thành</option>
        </select>

        @if (!User.IsInRole("Admin"))
        {
            <p class="form-hint">Truyện sẽ hiển thị công khai sau khi quản trị viên duyệt.</p>
        }
        <button class="btn btn-dark btn-block" type="submit">Lưu truyện</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
