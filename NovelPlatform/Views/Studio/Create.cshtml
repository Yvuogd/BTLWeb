@{
    ViewData["Title"] = "Tạo truyện";
}

<div class="form-page">
    <form class="form-card narrow" asp-action="Create" method="post">
        <a class="back-link" asp-action="Index">← Studio</a>
        <span class="eyebrow">BẮT ĐẦU MỘT CÂU CHUYỆN MỚI</span>
        <h1>Thông tin truyện</h1>
        <div asp-validation-summary="ModelOnly" class="form-error"></div>

        <label for="title">Tên truyện</label>
        <input id="title" name="title" maxlength="180" required />

        <label for="categoryId">Thể loại</label>
        <select id="categoryId" name="categoryId" asp-items="ViewBag.Categories" required>
            <option value="">Chọn thể loại</option>
        </select>

        <label for="description">Giới thiệu</label>
        <textarea id="description" name="description" rows="5" maxlength="2500"></textarea>

        <label for="coverImage">Đường dẫn ảnh bìa (tùy chọn)</label>
        <input id="coverImage" name="coverImage" maxlength="300" placeholder="/images/cloud-library.svg" />

        <label for="status">Trạng thái truyện</label>
        <select id="status" name="status">
            <option value="Ongoing">Đang ra</option>
            <option value="Completed">Hoàn thành</option>
        </select>

        @if (!User.IsInRole("Admin"))
        {
            <p class="form-hint">Truyện sẽ được gửi tới quản trị viên để kiểm duyệt trước khi hiển thị công khai.</p>
        }
        <button class="btn btn-dark btn-block" type="submit">Tạo truyện</button>
    </form>
</div>
