@model List<NovelPlatform.Models.Bookmark>
@{
    ViewData["Title"] = "Tủ sách của tôi";
}

<section class="content-section page-section">
    <div class="section-heading">
        <div>
            <span class="eyebrow">GÓC RIÊNG CỦA BẠN</span>
            <h1>Tủ sách của tôi</h1>
        </div>
        <span class="muted">@Model.Count truyện đã lưu</span>
    </div>

    @if (Model.Count > 0)
    {
        <div class="novel-grid">
            @foreach (var bookmark in Model)
            {
                <article class="novel-card">
                    <a asp-controller="Home"
                       asp-action="Details"
                       asp-route-id="@bookmark.NovelId"
                       class="cover">
                        <img src="@(bookmark.Novel.CoverImage ?? "/images/cloud-library.svg")"
                             alt="Bìa @bookmark.Novel.Title" />
                    </a>
                    <div class="card-body">
                        <div class="card-meta">
                            <span>@bookmark.Novel.Category?.Name</span>
                            <span>
                                ★ @(bookmark.Novel.Ratings.Count == 0
                                    ? "Mới"
                                    : bookmark.Novel.Ratings.Average(rating => rating.Score).ToString("0.0"))
                            </span>
                        </div>
                        <h3>
                            <a asp-controller="Home"
                               asp-action="Details"
                               asp-route-id="@bookmark.NovelId">
                                @bookmark.Novel.Title
                            </a>
                        </h3>
                        <p class="author">@bookmark.Novel.Author.DisplayName</p>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            Tủ sách đang chờ những câu chuyện đầu tiên.
            <a asp-controller="Home" asp-action="Index">Khám phá ngay →</a>
        </div>
    }
</section>
